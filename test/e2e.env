# e2e isolation: tests run against a throwaway database, never the demo's
# examples/notes/data.sqlite. The file is deleted at the start of every run, so tests
# assert on exact counts without inheriting rows from the previous run.
SQLITE_PATH=test/.tmp/e2e.sqlite

# The suite fires dozens of MCP calls per second from one caller — the demo's
# 20/s default is a production-shape guard, not a test constraint.
MCP_RATE_LIMIT=100000

# GitHub OAuth App (browser login):
#   Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               http://localhost:8020
#   Authorization callback URL: http://localhost:8020/api/auth/callback/github
# Copy the Client ID; generate a Client Secret (shown once).
#
# The same GitHub app drives the MCP OAuth 2.1 login: it is a normal OAuth
# login, so one callback URL covers both the browser and the MCP client.
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# Random string (>= 32 chars) signing better-auth sessions and tokens.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# Egress proxy for the OAuth server's outbound fetches (claude.ai CIMD
# metadata, github.com token exchange). Node's fetch ignores http_proxy /
# https_proxy — on networks that bot-check or throttle those hosts, name the
# proxy here. Leave empty for direct connections.
# OUTBOUND_PROXY=http://localhost:16780

# Public base URL of this server (OAuth issuer + redirect base).
# Defaults to http://localhost:${PORT}; set it when the demo sits behind a proxy.
# BASE_URL=http://localhost:8020

# Port the demo listens on. Default 8020.
# PORT=8020
